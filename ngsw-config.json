{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "assetGroups": [
    {
      "name": "app-shell",
      "installMode": "prefetch",
      "resources": {
        "files": ["/favicon.ico", "/index.html", "/manifest.webmanifest", "/*.css", "/*.js", "/i18n/*.json", "/icons/*"]
      }
    },
    {
      "name": "fonts",
      "installMode": "lazy",
      "updateMode": "prefetch",
      "resources": {
        "urls": ["https://fonts.googleapis.com/**", "https://fonts.gstatic.com/**"]
      }
    }
  ],
  "dataGroups": [
    {
      "name": "no-api-cache",
      "urls": ["/api/**"],
      "cacheConfig": { "strategy": "freshness", "maxSize": 0, "maxAge": "0u", "timeout": "10s" }
    }
  ],
  "navigationUrls": ["/**", "!/api/**", "!/**/*.*"]
}
